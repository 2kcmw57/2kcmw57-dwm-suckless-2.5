/* ==================================================
   ICON SETTINGS
   ================================================== */
#define ICONSIZE        20     /* default icon size in pixels */
#define ICONSPACING     4     /* space between icon and title */
#define ICON_SCALE      1.0   /* scale factor for high-DPI displays */
#define ICON_PADDING    1     /* extra padding around icons */

/* Derived icon dimensions */
#define ICON_TOTAL_WIDTH   ((int)(ICONSIZE * ICON_SCALE + ICON_PADDING))
#define ICON_TOTAL_HEIGHT  ((int)(ICONSIZE * ICON_SCALE + ICON_PADDING))


