/* ==================================================
   KEYBINDINGS
   ================================================== */
static const Key keys[] = {
    /* modifier                         key         function        argument */


    /* --------------------
       BRIGHTNESS & AUDIO
       -------------------- */
    {0,             XF86XK_AudioLowerVolume,    spawn, {.v = downvol}},
    {0,             XF86XK_AudioMute,           spawn, {.v = mutevol }},
    {0,             XF86XK_AudioRaiseVolume,    spawn, {.v = upvol}},
    {0,             XF86XK_MonBrightnessUp,     spawn, {.v = light_up}},
    {0,             XF86XK_MonBrightnessDown,   spawn, {.v = light_down}},


    /* --------------------
       WINDOW MANAGEMENT / VISUAL CONTROLS
       -------------------- */
    { MODKEY,                       XK_b,      togglebar,            {0} },      /* Show/hide bar */
    { MODKEY,                       XK_Tab,    view,                 {0} },      /* Switch to previous tag */
    { MODKEY|ShiftMask,             XK_space,  togglefloating,       {0} },      /* Toggle floating mode */
    { MODKEY,                       XK_0,      view,                 {.ui = ~0 } }, /* View all tags */
    { MODKEY|ShiftMask,             XK_0,      tag,                  {.ui = ~0 } }, /* Tag window with all tags */
    { MODKEY,                       XK_equal,   shiftview,            {.i = +1} }, /* next tag (usually '+' is Shift+'=') */
    { MODKEY,                       XK_minus,   shiftview,            {.i = -1} }, /* previous tag */
    { MODKEY,                       XK_comma,  focusmon,             {.i = -1 } }, /* Focus previous monitor */
    { MODKEY,                       XK_period, focusmon,             {.i = +1 } }, /* Focus next monitor */
    { MODKEY|Mod1Mask|ShiftMask,    XK_comma,  tagmon,               {.i = -1 } }, /* Move window to previous monitor */
    { MODKEY|Mod1Mask|ShiftMask,    XK_period, tagmon,               {.i = +1 } }, /* Move window to next monitor */

    /* --------------------
       LAUNCH PROGRAMS
       -------------------- */
    { MODKEY,                       XK_e,      spawn,                {.v = thunar } },     /* Launch Thunar */
    { MODKEY,                       XK_f,      spawn,                {.v = firefox } },    /* Launch Firefox */
    { MODKEY,                       XK_t,      spawn,                {.v = geany } },      /* Launch Geany */
    { MODKEY|ShiftMask,             XK_d,      spawn,                {.v = codium } },      /* Launch Geany */
    { MODKEY,                       XK_d,      spawn,                {.v = rofi } },       /* Launch Rofi menu */
    { MODKEY,                       XK_a,      spawn,                {.v = audacious} },   /* Launch Rofi menu */
    { MODKEY,                       XK_Return, spawn,                {.v = termcmd } },    /* Launch terminal */

    /* --------------------
       WINDOW STACK / FOCUS / MOVEMENT
       -------------------- */
    { MODKEY,                       XK_Right,  focusstack,           {.i = +1 } }, /* Focus next window */
    { MODKEY,                       XK_Left,   focusstack,           {.i = -1 } }, /* Focus previous window */
    { MODKEY,                       XK_Up,  focusstack,           {.i = +1 } }, /* Focus next window */
    { MODKEY,                       XK_Down,   focusstack,           {.i = -1 } }, /* Focus previous window */
    { MODKEY|ControlMask,           XK_Left,   setmfact,             {.f = -0.05} }, /* Shrink master area */
    { MODKEY|ControlMask,           XK_Right,  setmfact,             {.f = +0.05} }, /* Grow master area */
    { MODKEY|ShiftMask,             XK_Right,  movestack,            {.i = +1 } }, /* Move window down stack */
    { MODKEY|ShiftMask,             XK_Left,   movestack,            {.i = -1 } }, /* Move window up stack */

    /* --------------------
       TAG / VIEW / GAPS CONTROLS
       -------------------- */
    /* GAPS MANAGEMENT */
    { Mod1Mask,                     XK_9,      incrgaps,             {.i = 3 } }, /* Increase all gaps */
    { Mod1Mask,                     XK_0,      incrgaps,             {.i = -3 } }, /* Decrease all gaps */
    { MODKEY|Mod1Mask,              XK_i,      incrigaps,            {.i = 1 } }, /* Increase inner gaps */
    { MODKEY|Mod1Mask|ShiftMask,    XK_i,      incrigaps,            {.i = -1 } },
    { MODKEY|Mod1Mask,              XK_o,      incrogaps,            {.i = 1 } }, /* Increase outer gaps */
    { MODKEY|Mod1Mask|ShiftMask,    XK_o,      incrogaps,            {.i = -1 } },
    { MODKEY|Mod1Mask,              XK_6,      incrihgaps,           {.i = 1 } }, /* Increase inner horizontal gaps */
    { MODKEY|Mod1Mask|ShiftMask,    XK_6,      incrihgaps,           {.i = -1 } },
    { MODKEY|Mod1Mask,              XK_7,      incrivgaps,           {.i = 1 } }, /* Increase inner vertical gaps */
    { MODKEY|Mod1Mask|ShiftMask,    XK_7,      incrivgaps,           {.i = -1 } },
    { MODKEY|Mod1Mask,              XK_8,      incrohgaps,           {.i = 1 } }, /* Increase outer horizontal gaps */
    { MODKEY|Mod1Mask|ShiftMask,    XK_8,      incrohgaps,           {.i = -1 } },
    { MODKEY|Mod1Mask,              XK_9,      incrovgaps,           {.i = 1 } }, /* Increase outer vertical gaps */
    { MODKEY|Mod1Mask|ShiftMask,    XK_9,      incrovgaps,           {.i = -1 } },
    { MODKEY|Mod1Mask,              XK_0,      togglegaps,           {0} }, /* Toggle gaps on/off */
    { MODKEY|Mod1Mask|ShiftMask,    XK_0,      defaultgaps,          {0} }, /* Reset gaps to default */
    { 0,                            XK_F11,    togglefullscr,        {0} },
    { 0,         XK_Print, spawn, screenshot_full },
    { ShiftMask, XK_Print, spawn, screenshot_sel  },


    /* --------------------
