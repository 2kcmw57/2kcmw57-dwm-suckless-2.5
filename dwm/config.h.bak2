    { 0,                            XK_F2,      setlayout,            {.v = &layouts[1] } },
    { 0,                            XK_F3,      setlayout,            {.v = &layouts[2] } },
    { 0,                            XK_F4,      setlayout,            {.v = &layouts[3] } },
    { 0,                            XK_F5,      setlayout,            {.v = &layouts[4] } },
    { 0,                            XK_F6,      setlayout,            {.v = &layouts[5] } },
    { 0,                            XK_F7,      setlayout,            {.v = &layouts[6] } },
    

    /* --------------------
       TAG KEYS
       -------------------- */
    TAGKEYS(                        XK_1,                      0)
    TAGKEYS(                        XK_2,                      1)
    TAGKEYS(                        XK_3,                      2)
    TAGKEYS(                        XK_4,                      3)
    TAGKEYS(                        XK_5,                      4)
    TAGKEYS(                        XK_6,                      5)
    TAGKEYS(                        XK_7,                      6)
   
 
   

    /* --------------------
       OTHER / MISC (master count, kill/restart/hide) 
       -------------------- */
    { MODKEY|Mod1Mask|ShiftMask,    XK_Tab,    incnmaster,           {.i = +1 } },  /* Increase master clients */
    { MODKEY|Mod1Mask,              XK_Tab,    incnmaster,           {.i = -1 } },  /* Decrease master clients */

    /* Kill / Restart / Hide / Restore */
    { MODKEY|ControlMask,               XK_r,       spawn,          SHCMD("killall bar.sh chadwm") },
    { MODKEY|ShiftMask, XK_q, quit, {0} },  /* exit dwm */
    { MODKEY|ShiftMask, XK_r, quit, {1} },  /* restart dwm */
    { MODKEY,                           XK_q,       killclient,     {0} },  /* Close focused window */
    { MODKEY,                           XK_h,       hidewin,        {0} },
    { MODKEY|ShiftMask,                 XK_e,       restorewin,     {0} },
